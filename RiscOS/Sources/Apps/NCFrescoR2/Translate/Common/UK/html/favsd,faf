<HTML>
  <HEAD>
    <TITLE>Edit favourites</TITLE>
    <META NAME="ncbrowsermode" CONTENT="nooverridecharset; noscale; nohistory; position=fullscreen; ensuretoolbar=1; selectbutton=0x2027; selected=default">
    <META HTTP-EQUIV=Content-Type CONTENT="text/html; charset=utf-8">
    <LINK HREF="file:///NCFresco:html/global.css" REL="stylesheet" TITLE="default" TYPE="text/css">
  </HEAD>
  <BODY>
    <TABLE WIDTH="549" BORDER=0 CELLSPACING=0 CELLPADDING=0 ALIGN=CENTER>
      <TR><TD COLSPAN=3><IMG ALIGN=ABSBOTTOM SRC="icontype:titdelef"></TD></TR>
      <TR><TD COLSPAN=3 HEIGHT=16>&nbsp;</TD></TR>
      <TR>
        <TD COLSPAN=3 VALIGN=TOP HEIGHT=40 ALIGN=LEFT>
          <FONT SIZE="4">
            <FORM ACTION="ncint:openpanel" TARGET="_self">
              <INPUT TYPE=HIDDEN NAME=name VALUE=favswitch>
              <INPUT TYPE=HIDDEN NAME=mode VALUE=show>
              <INPUT TYPE=HIDDEN NAME=target VALUE="%r">
              <INPUT TYPE=SUBMIT VALUE="List favourites" BORDERIMAGE="icontype:butt_bord" SELIMAGE="icontype:butt_sel">
            </FORM>
          </FONT>
        </TD>
      </TR>
      <TR>
        <TD HEIGHT=25 VALIGN=MIDDLE COLSPAN=3>
          <HR>
          <FORM TARGET="_self" ID=favsd ACTION="ncint:process">
            <INPUT TYPE=HIDDEN NAME=name VALUE=favsdelete>
            <INPUT TYPE=HIDDEN NAME=remove VALUE="__pel_favswitch">
        </TD>
      </TR>
%(
      <TR><TH colspan=3><B>&bull;&nbsp;&nbsp;%t</B></TH></TR>
%(
      <TR>
        <TD ALIGN=LEFT WIDTH=40 VALIGN=MIDDLE>
          <INPUT ID="i.%i" NAME="checked" TYPE=CHECKBOX WIDTH=30 HEIGHT=30 BORDER=0 BORDERIMAGE="icontype:trashb" SELIMAGE="icontype:trash" VALUE="%u" TABINDEX="-1" >
        </TD>
        <TD ALIGN=LEFT LANG="%l" VALIGN=MIDDLE>
          <IMG SRC="icontype:blankicon" HEIGHT=1 WIDTH=20><B><LABEL ID="%i" FOR="i.%i">%t</LABEL></B>
        </TD>
      </TR>
      <TR><TD COLSPAN=3 HEIGHT=4></TD></TR>
%)
%)
      <TR>
        <TD COLSPAN=3 HEIGHT=50 VALIGN=BOTTOM ALIGN=LEFT>
          <FONT SIZE="4">
            <INPUT TYPE=SUBMIT BORDERIMAGE="icontype:butt_bord" SELIMAGE="icontype:butt_sel" NAME=action.delete VALUE="Confirm Delete">
          </FONT>
          </FORM>
        </TD>
      </TR>
      <TR>
        <TD HEIGHT=20 VALIGN=BOTTOM COLSPAN=2><HR></TD>
      </TR>
      <TR>
        <TD COLSPAN=3 HEIGHT=50 ALIGN=LEFT VALIGN=BOTTOM>
          <FONT SIZE={<GLOBAL_smallsize>}>
            <FORM ACTION="ncint:openpanel" TARGET="_self"><INPUT TYPE=HIDDEN NAME=name VALUE=favswitch>
              <INPUT TYPE=HIDDEN NAME=mode VALUE=show>
              <INPUT TYPE=HIDDEN NAME=target VALUE="%r">
              <INPUT TYPE=SUBMIT CLASS="button" VALUE="List favourites" BORDERIMAGE="icontype:butt_bord" SELIMAGE="icontype:butt_sel">
            </FORM>
          </FONT>
        </TD>
      </TR>
    </TABLE>
  </BODY>
</HTML>
