function confirm_modify(n, password)
{
  var tester, return_value;

  if (password != document.myform.old_password.value)
  {
    alert("êêModify_H_wrongpasswordëë");
  }
  else
  {
    if (document.myform.new_password.value != "") // New password entered
    {
      if (document.myform.new_password.value != document.myform.retype_password.value)
      {
        alert("êêModify_H_reenterëë");
        document.myform.new_password.value = "";
        document.myform.retype_password.value = "";

        document.all['new_password_cell'].bgColor = '#ffffaa';
        document.all['retype_password_cell'].bgColor = '#ffffaa';

        return;
      }
    }

    // **** Check that there is something in all entry fields ****

    if (document.myform.address.value == "" || document.myform.username.value == "" || document.myform.old_password.value == "" || document.myform.pophostname.value == "" || document.myform.smtphostname.value == "")
    {
      alert("êêModify_H_allfieldsëë");

      return;
    }

    // **** Check for duplicate address or username.  Blat the current one in the hidden list so it
    //      can't match the one that's being changed!  Easier than conditional checking.

    document.records["hidden_address" + n].value = "x8s01@#sd~x";
    document.records["hidden_username" + n].value = "7#~sr3@wq2x";

    for (i = 0; i < document.records.hidden_number_of_records.value; i++)
    {
      if (document.myform.address.value == document.records["hidden_address" + i].value)
      {
        alert("êêModify_H_addressexistsëë");
        document.myform.address.value = "";
        document.all['email_cell'].bgColor = '#ffffaa';
        return;
      }
      else
      {
        if (document.myform.username.value == document.records["hidden_username" + i].value)
        {
          alert("êêModify_H_usernameexistsëë");
          document.myform.username.value = "";
          document.all['username_cell'].bgColor = '#ffffaa';
          return;
        }
      }
    }

    document.location.href = "m_submit.pl?path="+document.records.hidden_path.value+"&modify=0&user="+n+"&"
                             +document.myform.account.name+"="+document.myform.account.value+"&"
                             +document.myform.pophostname.name+"="+document.myform.pophostname.value+"&"
                             +document.myform.smtphostname.name+"="+document.myform.smtphostname.value+"&"
                             +document.myform.address.name+"="+document.myform.address.value+"&"
                             +document.myform.username.name+"="+document.myform.username.value+"&"
                             +document.myform.old_password.name+"="+document.myform.old_password.value+"&"
                             +document.myform.new_password.name+"="+document.myform.new_password.value+"&"
                             +document.myform.retype_password.name+"="+document.myform.retype_password.value+"&"
                             +"flags="+document.myform.default_account.checked;
  }

  return;
}

