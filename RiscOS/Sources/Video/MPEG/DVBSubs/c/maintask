/*****************************************************************************
* DisplayPage
*
* Displays a page whose PTS has been reached; if this is the first page
* of a new epoch, also frees resources claimed by the old epoch
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void DisplayPage(void)
{
  RCS_t *RCS;
  dprintf(("Function", "DisplayPage\n"));
  /* If we're switching epochs, free the old one */
  if (static_DisplayPCS != static_DecodePCS)
  {
    FreeResources(static_DisplayPCS);
    static_DisplayPCS = static_DecodePCS;
  }
  /* For each RCS that exists, determine if it's opening, closing or moving */
  for (RCS = static_DisplayPCS->RCSList; RCS != NULL; RCS = RCS->next)
  {
    int8_t region = static_DisplayPCS->nregions;
    while (--region >= 0)
    {
      if (static_DisplayPCS->region[region].region_id == RCS->id)
      {
        break;
      }
    }
    if (region < 0 && RCS->visible)
    {
      CHECK(wimp_close_window(&RCS->window_handle));
      RCS->visible = false;
    }
    else if (region >= 0)
    {
      WimpOpenWindowBlock openblock;
      openblock.window_handle = RCS->window_handle;
      openblock.visible_area.xmin = static_XOrigin + static_DisplayPCS->region[region].region_horizontal_address * 2;
      openblock.visible_area.ymax = static_YOrigin - static_DisplayPCS->region[region].region_vertical_address * 2;
      openblock.visible_area.xmax = openblock.visible_area.xmin + RCS->width * 2;
      openblock.visible_area.ymin = openblock.visible_area.ymax - RCS->height * 2;
      openblock.xscroll = openblock.yscroll = 0;
      openblock.behind = -1;
      CHECK(wimp_open_window(&openblock));
      RCS->visible = true;
    }
    /* Reset a couple of flags in the RCS struct */
    RCS->clut_updated = false;
    RCS->new_objects = false;
  }
  static_DisplayPCS->displayed = true;
  inline_OS_IntOff();
  RecalcPollword();
  inline_OS_IntOn();
}

/*****************************************************************************
* SkipToNextPESPacket
*
* Keeps freeing bitstream packet descriptors until one is reached that has
* the MPEGStart flag bit set
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void SkipToNextPESPacket(void)
{
  bool NewPES;
  do
  {
    NewPES = NewPacket();
  }
  while (NewPES == false);
}

/*****************************************************************************
* SkipBytes
*
* Steps forward through the current packet by a number of bytes, getting
* new packets as they are exhausted
*
* Assumptions
*  NONE
*
* Inputs
*  bytes: number of bytes to skip
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void SkipBytes(size_t bytes)
{
  while (bytes > static_DataLength)
  {
    bytes -= static_DataLength;
    static_PESLength -= static_DataLength;
    NewPacket();
  }
  static_DataStart += bytes;
  static_DataLength -= bytes;
  static_PESLength -= bytes;
}

/*****************************************************************************
* GetHalfWord
*
* Reads a 16-bit number from the stream (fetching new packet(s) if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint16_t GetHalfWord(void)
{
  uint16_t halfword = GetByte();
  halfword <<= 8;
  halfword |= GetByte();
  return halfword;
}

/*****************************************************************************
* GetByte
*
* Reads an 8-bit number from the stream (after fetching a new packet if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint8_t GetByte(void)
{
  uint8_t byte;
  while (static_DataLength == 0)
  {
    NewPacket();
  }
  byte = *static_DataStart++;
  static_DataLength--;
  static_PESLength--;
  return byte;
}

/*****************************************************************************
* GetBits
*
* Reads a bitfield from the stream (fetching a new packet if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  bits: number of bits to fetch (up to 32)
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint32_t GetBits(uint32_t bits)
{
  uint32_t result = 0;
  while (bits > 0)
  {
    uint32_t bits_this_time = MIN(bits, static_BitsInByte);
    result <<= bits_this_time;
    while (static_DataLength == 0)
    {
      NewPacket();
    }
    result |= (*static_DataStart >> (static_BitsInByte - bits_this_time)) & ((1 << bits_this_time) -1);
    bits -= bits_this_time;
    static_BitsInByte -= bits_this_time;
    if (static_BitsInByte == 0)
    {
      static_DataStart++;
      static_DataLength--;
      static_PESLength--;
      static_BitsInByte = 8;
    }
  }
  return result;
}

/*****************************************************************************
* ByteAlign
*
* Aligns the bitfield reader to a byte boundary
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ByteAlign(void)
{
  if (static_BitsInByte < 8)
  {
    static_DataStart++;
    static_DataLength--;
    static_PESLength--;
    static_BitsInByte = 8;
  }
}

/*****************************************************************************
* NewPacket
*
* The hub of the whole system: this appears from the point of view of the
* caller to return with the next bitstream packet to process. In practice,
* it will actually Wimp_Poll if the packet list is exhausted, so all Wimp
* events are dispatched from here. Control is returned when new data arrives
* using a Wimp pollword, but the pollword is shared between indicating that
* new data is available, and that a timestamp match has occurred. The packet
* list is treated as empty if it contains data that is timestamped later than
* the currently decoding display set (ie the display set that has started
* decoding, but which has not been displayed yet).
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  static_DataPTS, static_DataPTSValid, static_DataStart, static_DataLength,
*  and, if a new PES packet, static_PESLength are updated
*
* Returns
*  true if the bitstream packet descriptor is at the head of a PES packet
*****************************************************************************/
static bool NewPacket(void)
{
  static PacketDescriptor_t *WorkingPacket = (PacketDescriptor_t *) -1;
    /* ie initialise with magic value guaranteed not be be on the packet list */
  packet_FreeHead_USR(&static_PacketListHead, &static_PacketListTail, WorkingPacket);
  
  while (true)
  {
    /* Check for data that should be decoded at this time */
    do
    {
      /* Make an atomic copy of the head link, to cope with asynchronous update */
      WorkingPacket = static_PacketListHead;
      
      if (WorkingPacket == NULL)
      {
        /* We usually get here because we've just freed the last packet on the list. */
        /* If so, we need to clear the pollword so that Wimp_Poll doesn't immediately return. */
        /* If the pollword would have been set due to a pending PTS match, this isn't a */
        /* problem, because we're just about to test that ourselves. */
        /* There is a slim chance that data may have arrived in the interval between the */
        /* assignment and test of WorkingPacket, but even then, the pollword will be set at */
        /* the next VSync, at the latest. */
        static_PollWord = false;
      }
      else
      {
        /* Check packet at head of list for special actions */
        if (WorkingPacket == &static_MagicDescriptor_Reset)
        {
          longjmp(static_RestartBuf, 1);
        }
        else if (WorkingPacket == &static_MagicDescriptor_Exit)
        {
          exit(EXIT_SUCCESS);
        }
        
        /* Unless the data on the list is for the next PTS and we haven't */
        /* displayed this one yet, return the next packet (if any) */
        if (static_DecodePCS->displayed ||
            (WorkingPacket->Flags & PacketDescriptorFlags_PTSValid) == 0 ||
            (WorkingPacket->PTS.word.lo == static_DecodePCS->PTS.word.lo && WorkingPacket->PTS.word.hi == static_DecodePCS->PTS.word.hi) ||
            !static_DecodePCS->PTS_known)
        {
          bool NewPES = (WorkingPacket->Flags & PacketDescriptorFlags_MPEGStart) != 0;
          static_DataStart = WorkingPacket->Start;
          static_DataLength = WorkingPacket->Length;
          if (NewPES)
          {
            static_PESLength = WorkingPacket->FullLength;
          }
          if ((WorkingPacket->Flags & PacketDescriptorFlags_PTSValid) != 0)
          {
            if (static_DataPTSValid && mpegtime_Before(WorkingPacket->PTS, static_DataPTS))
            {
              /* Oops, time has jumped backwards */
              /* We'd better reset ourselves */
              longjmp(static_RestartBuf, 1);
            }
            static_DataPTS.word.lo = WorkingPacket->PTS.word.lo;
            static_DataPTS.word.hi = WorkingPacket->PTS.word.hi;
            static_DataPTSValid = true;
          }
          if (WorkingPacket != static_PacketListHead)
          {
            /* Blast, it's been freed while I wasn't looking */
            /* The pointers I read from the descriptor may be bad, */
            /* so we'll just have to ditch it altogether */
            continue; /* this is effectively a goto to the do statement ;-) */
          }
          /* Return to our caller, which will read static_DataStart/Length */
          return(NewPES);
        }
      }
    }
    while (false);
    
    /* Check if it's time to display the page */
    if (static_DecodePCS->PTS_known && !static_DecodePCS->displayed)
    {
      mpeg_time_t STC = { 0, 0 };
      _swix(MPEGControl_ReadParameters, _INR(0,1)|_OUTR(1,2),
            3,
            static_ControlStreamHandle,
            &STC.word.lo,
            (&STC.word.lo) + 1);
      if ((STC.word.lo != 0 || STC.word.hi != 0) &&
          !mpegtime_Before(STC, static_DecodePCS->PTS))
      {
        DisplayPage();
      }
    }
    
    /* Poll until something interesting happens */
    {
      int event_code;
      do
      {
        CHECK(event_poll(&event_code, NULL, &static_PollWord));
      }
      while (event_code != Wimp_EPollWordNonZero);
    }
  } /* end while (true) */
}

/*****************************************************************************
* RecalcPollword
*
* Sets the pollword appropriately when some aspect of the state has changed
* (necessary in order to share a single pollword for waking up the task)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void RecalcPollword(void)
{
  /* Check for pertinent stuff on the packet list */
  PacketDescriptor_t *HeadPacket = static_PacketListHead; /* lose volatile attribute */
  static_PollWord = false; /* default state */
  if (HeadPacket != NULL)
  {
    /* Magic packets always need acting on */
    if (HeadPacket == &static_MagicDescriptor_Reset || HeadPacket == &static_MagicDescriptor_Exit)
    {
      static_PollWord = true;
    }
    else
    {
      /* If we haven't got our first PTS yet, or */
      /* if the head packet on the list matches the current PTS, or */
      /* if the head packet on the list has no PTS, or */
      /* if the head packet on the list is for a later PTS and we've displayed the current page */
      /* then we need to decode some data */
      if (static_DecodePCS->displayed ||
          (HeadPacket->Flags & PacketDescriptorFlags_PTSValid) == 0 ||
          (HeadPacket->PTS.word.lo == static_DecodePCS->PTS.word.lo && HeadPacket->PTS.word.hi == static_DecodePCS->PTS.word.hi) ||
          !static_DecodePCS->PTS_known)
      {
        static_PollWord = true;
      }
    }
  }
  /* Check for a time match (unless we've already established that the pollword is set!) */
  if (static_PollWord == false && static_DecodePCS->PTS_known && !static_DecodePCS->displayed)
  {
    mpeg_time_t STC = { 0, 0 };
    _swix(MPEGControl_ReadParameters, _INR(0,1)|_OUTR(1,2),
          3,
          static_ControlStreamHandle,
          &STC.word.lo,
          (&STC.word.lo) + 1);
    if ((STC.word.lo != 0 || STC.word.hi != 0) &&
        !mpegtime_Before(STC, static_DecodePCS->PTS))
    {
      static_PollWord = true;
    }
  }
}

/*****************************************************************************
* MyAlloc
*
* Allocates a block of memory from the heap, throwing an error if it can't
*
* Assumptions
*  NONE
*
* Inputs
*  size:       number of bytes to allocate in block
*  init_value: byte value to initialise block with
*
* Outputs
*  NONE
*
* Returns
*  pointer to block
*****************************************************************************/
static void *MyAlloc(size_t size, uint8_t init_value)
{
  void *memory = malloc(size);
  if (memory == NULL)
  {
    inline_OS_GenerateError(mess_GenerateError("err_Mem", 1, 0));
  }
  memset(memory, init_value, size);
  return memory;
}

/*****************************************************************************
* maintask_RemoveHandlers
*
* Remove any installed direct-call handlers (prior to module death)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
void maintask_RemoveHandlers(void)
{
  /* At least one of these will produce an error, but that's okay */
  _swix(OS_Release, _INR(0,2),
        UpCallV,
        upcallv_handler,
        global_PrivateWord);
  _swix(MPEGControl_DeregisterDescriptorHandler, _INR(0,4),
        DHFlags_StreamSpecific,
        DVB_SUBTITLING_DESCRIPTOR_TAG,
        descriptor_handler,
        global_PrivateWord,
        static_ControlStreamHandle);
  if (static_SubtitlePID != 0)
  {
    _swix(MPEGControl_DeregisterProgramElementHandler, _INR(0,4),
          PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
          static_SubtitlePID,
          program_element_handler,
          global_PrivateWord,
          static_ControlStreamHandle);
    static_SubtitlePID = 0;
  }
  if (static_EventVClaimed)
  {
    _swix(OS_Byte, _INR(0,1),
          13,
          Event_VSync);
    _swix(OS_Release, _INR(0,2),
          EventV,
          eventv_handler,
          global_PrivateWord);
    static_EventVClaimed = false;
  }
}

/*****************************************************************************
* FindScreenOrigin
*
* Compensates for VIDC border
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void FindScreenOrigin(void)
{
  uint32_t in_block[5] = { 4, 5, 11, 12, -1 };
  uint32_t out_block[4];
  uint32_t width;
  uint32_t height;
  _swix(OS_ReadVduVariables, _INR(0,1),
        in_block,
        out_block);
  width = out_block[2] << out_block[0];
  height = out_block[3] << out_block[1];
  static_XOrigin = (width / 2) - 720;
  static_YOrigin = (height / 2) + 576; /* doesn't matter that it's exclusive, because so are window tops */
}

