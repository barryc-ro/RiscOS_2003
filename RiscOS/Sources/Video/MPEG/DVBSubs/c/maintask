/*****************************************************************************
* maintask_UpCallVHandler
*
* UpCallV handler (for UpCall_MPEG)
*
* Assumptions
*  NONE
*
* Inputs
*  r:  registers on entry
*  pw: the 'R12' value
*
* Outputs
*  NONE
*
* Returns
*  0 to intercept; 1 to pass on
*****************************************************************************/
int maintask_UpCallVHandler(_kernel_swi_regs *r, void *pw)
{
  IGNORE(pw);
  if (r->r[0] == UpCall_MPEG && r->r[3] == UpCallMPEG_OpenStream)
  {
    /* If we can now determine our control stream handle, then */
    /* register a descriptor handler, and get off UpCallV */
    _kernel_oserror *e;
    uint32_t OptionsBlock[] = { vc_tags_control_handle, 1, 0, vc_tags__end };
    e = _swix(VideoControl_Options, _INR(0,2),
              VC_Options_ReadValues,
              static_VideoCtrlClientHandle,
              OptionsBlock);
    if (e == NULL && OptionsBlock[2] != 0)
    {
      static_ControlStreamHandle = OptionsBlock[2];
      _swix(MPEGControl_RegisterDescriptorHandler, _INR(0,4),
            DHFlags_StreamSpecific,
            DVB_SUBTITLING_DESCRIPTOR_TAG,
            descriptor_handler,
            global_PrivateWord,
            static_ControlStreamHandle);
      _swix(OS_Release, _INR(0,2),
            UpCallV,
            upcallv_handler,
            global_PrivateWord);
    }
  }
  return 1;
}

/*****************************************************************************
* maintask_DescriptorHandler
*
* MPEGControl Descriptor Handler (for DVB subtitling descriptors)
*
* Assumptions
*  NONE
*
* Inputs
*  r:  registers on entry
*  pw: the 'R12' value
*
* Outputs
*  r:  updated or not, as appropriate
*
* Returns
*  NULL if successful; otherwise pointer to error block
*****************************************************************************/
_kernel_oserror *maintask_DescriptorHandler(_kernel_swi_regs *r, void *pw)
{
  static struct
  {
    uint32_t es_id; /* or 0 if not present */
    uint8_t composition_page_hi;
    uint8_t composition_page_lo;
    uint8_t ancillary_page_hi;
    uint8_t ancillary_page_lo;
  }
  AspectVersion[4]; /* array for collating data for all aspect ratios */
  static uint8_t BytesLeft; /* how much data remains in this descriptor */
  static bool Bogus; /* true if descriptor appears to be corrupt */
  static bool Match; /* true if what we've seen so far of this loop matches our criteria */
  static uint8_t Aspect; /* 0-3 if language/hard-of-hearing match, value = AspectVersion index */
  IGNORE(pw);
  switch (r->r[0])
  {
    case DHReason_OpenStream:
      /* Give it an arbitrary non-null handle - we don't actually use it */
      r->r[0] = 1;
      break;
      
    case DHReason_DataTransfer:
      /* Process the data */
      {
        PacketDescriptor_t *packet = (PacketDescriptor_t *) r->r[3];
        while (packet != NULL)
        {
          if (packet->Flags & PacketDescriptorFlags_MPEGStart)
          {
            BytesLeft = packet->FullLength;
            Bogus = ((BytesLeft & 7) != 0);
          }
          if (!Bogus)
          {
            while (packet->Length > 0)
            {
              uint8_t byte = *packet->Start++;
              packet->Length--;
              switch ((--BytesLeft) & 7)
              {
                case 7:
                  Match = true;
                  if (byte != static_ISO639Lang[0])
                  {
                    Match = false;
                  }
                  break;
                case 6:
                  if (byte != static_ISO639Lang[1])
                  {
                    Match = false;
                  }
                  break;
                case 5:
                  if (byte != static_ISO639Lang[2])
                  {
                    Match = false;
                  }
                  break;
                case 4:
                  Aspect = byte - (static_HardOfHearing ? 0x20 : 0x10);
                  if (Aspect < 4u)
                  {
                    AspectVersion[Aspect].es_id = (uint32_t) r->r[4];
                  }
                  else
                  {
                    Match = false;
                  }
                  break;
                case 3:
                  if (Match)
                  {
                    AspectVersion[Aspect].composition_page_hi = byte;
                  }
                  break;
                case 2:
                  if (Match)
                  {
                    AspectVersion[Aspect].composition_page_lo = byte;
                  }
                  break;
                case 1:
                  if (Match)
                  {
                    AspectVersion[Aspect].ancillary_page_hi = byte;
                  }
                  break;
                case 0:
                  if (Match)
                  {
                    AspectVersion[Aspect].ancillary_page_lo = byte;
                  }
                  break;
              }
            }
          }
          packet_FreeHead_SVC(&packet, NULL);
        }
      }
      break;
      
    case DHReason_CloseStream:
      /* Deregister ourselves */
      _swix(MPEGControl_DeregisterDescriptorHandler, _INR(0,4),
            DHFlags_StreamSpecific,
            DVB_SUBTITLING_DESCRIPTOR_TAG,
            descriptor_handler,
            global_PrivateWord,
            static_ControlStreamHandle);
      /* Deregister program element handler */
      if (static_SubtitlePID != 0)
      {
        _swix(MPEGControl_DeregisterProgramElementHandler, _INR(0,4),
              PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
              static_SubtitlePID,
              program_element_handler,
              global_PrivateWord,
              static_ControlStreamHandle);
        static_SubtitlePID = 0;
      }
      /* Free any packets we still have, and tell foreground to reset itself */
      BackgroundFlush(&static_MagicDescriptor_Reset);
      break;
      
    case DHReason_ResetStream:
      /* Reset AspectVersion es_id, ready for next stream segment */
      for (Aspect = 0; Aspect < 4; Aspect++)
      {
        AspectVersion[Aspect].es_id = 0;
      }
      /* Deregister program element handler */
      if (static_SubtitlePID != 0)
      {
        _swix(MPEGControl_DeregisterProgramElementHandler, _INR(0,4),
              PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
              static_SubtitlePID,
              program_element_handler,
              global_PrivateWord,
              static_ControlStreamHandle);
        static_SubtitlePID = 0;
      }
      /* Free any packets we still have, and tell foreground to reset itself */
      BackgroundFlush(&static_MagicDescriptor_Reset);
      break;
      
    case DHReason_EndOfTable:
      /* Decide which descriptor we should be working from */
      {
        uint32_t Preferred = 0;
        uint32_t ScalingType = 0;
        uint32_t TVAspect = 0;
        _swix(MPEGControl_SetVideoParameters, _INR(0,2)|_OUT(2)|_OUT(4),
              0,
              static_ControlStreamHandle,
              -1,
              &ScalingType,
              &TVAspect);
        if (ScalingType == 0)
        {
          /* Full-screen playback: prefer subtitles appropriate to TV aspect ratio */
          if (TVAspect == VideoStructureScalingTVAspectRatio_4_3)
          {
            Preferred = 1;
          }
          else
          {
            Preferred = 2;
          }
        }
        else
        {
          /* Probably windowed: prefer subtitles appropriate to active area of MPEG picture */
          const uint32_t tags[2] = { 0x1011, -1 };
          uint32_t result[9];
          result[0] = 0;
          _swix(MPEGControl_Stats, _INR(0,4),
                0,
                static_ControlStreamHandle,
                tags,
                result,
                sizeof(result));
          if (result[0] == 0x1011)
          {
            if (result[4] < 0x18E39) /* half-way between 4:3 and 16:9 */
            {
              Preferred = 1;
            }
            else if (result[4] < 0x1FE70) /* half-way between 16:9 and 2.21:1 */
            {
              Preferred = 2;
            }
            else
            {
              Preferred = 3;
            }
          }
        }
        if (AspectVersion[Preferred].es_id == 0)
        {
          Preferred = 0;
        }
        if ((AspectVersion[Preferred].es_id & 0x1FFF) != static_SubtitlePID)
        {
          /* Subtitle stream has arrived, gone away or changed PID */
          if (static_SubtitlePID != 0)
          {
            _swix(MPEGControl_DeregisterProgramElementHandler, _INR(0,4),
                  PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
                  static_SubtitlePID,
                  program_element_handler,
                  global_PrivateWord,
                  static_ControlStreamHandle);
            static_SubtitlePID = 0;
          }
          if (AspectVersion[Preferred].es_id != 0)
          {
            static_SubtitlePID = AspectVersion[Preferred].es_id & 0x1FFF;
            /* I'll eat my hat if DVB subtitles ever appear in a program stream with program stream map! */
            _swix(MPEGControl_RegisterProgramElementHandler, _INR(0,4),
                  PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
                  static_SubtitlePID,
                  program_element_handler,
                  global_PrivateWord,
                  static_ControlStreamHandle);
            static_CompositionPage = (AspectVersion[Preferred].composition_page_hi << 8) + AspectVersion[Preferred].composition_page_lo;
            static_AncillaryPage =  (AspectVersion[Preferred].ancillary_page_hi << 8) + AspectVersion[Preferred].ancillary_page_lo;
          }
        }
      }
      break;
      
    default:
      /* ignore any unknown reason codes */
      break;
  }
  return NULL;
}

/*****************************************************************************
* maintask_ProgramElementHandler
*
* MPEGControl Program Element Handler (for DVB subtitle elementary stream)
*
* Assumptions
*  NONE
*
* Inputs
*  r:  registers on entry
*  pw: the 'R12' value
*
* Outputs
*  r:  updated or not, as appropriate
*
* Returns
*  NULL if successful; otherwise pointer to error block
*****************************************************************************/
_kernel_oserror *maintask_ProgramElementHandler(_kernel_swi_regs *r, void *pw)
{
  IGNORE(pw);
  switch (r->r[0])
  {
    case PEHReason_OpenStream:
      /* Give it an arbitrary non-null handle - we don't actually use it */
      r->r[0] = 1;
      break;
      
    case PEHReason_DataTransfer:
      /* Add the data to our list */
      {
        PacketDescriptor_t *packet = (PacketDescriptor_t *) r->r[3];
        if (static_PacketListHead == NULL)
        {
          static_PacketListHead = packet;
          RecalcPollword();
        }
        else
        {
          static_PacketListTail->Link = packet;
        }
        while (packet->Link != NULL)
        {
          packet = packet->Link;
        }
        static_PacketListTail = packet;
      }
      break;
      
    default:
      /* ignore any other reason codes */
      break;
  }
  return NULL;
}

