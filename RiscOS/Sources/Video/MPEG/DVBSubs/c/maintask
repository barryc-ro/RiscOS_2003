/*****************************************************************************
* New type definitions
*****************************************************************************/
typedef struct
{
  size_t size;
  uint32_t nsprites;
  size_t firstsprite;
  size_t freeword;
  struct
  {
    size_t next;
    char name[12];
    uint32_t wordsaross;
    uint32_t height;
    uint32_t firstbit;
    uint32_t lastbit;
    size_t image;
    size_t mask;
    uint32_t mode;
  } sprite;
} sprite_area_header_t;

typedef struct RCS_object_list
{
  struct RCS_object_list *next;
  uint16_t object_id;
  uint32_t object_horizontal_position: 16;
  uint32_t object_vertical_position: 16;
  uint32_t foreground_pixel_code: 8;
  uint32_t background_pixel_code: 8;
  uint32_t object_type: 2;
} RCS_object_list_t;

typedef struct RCS
{
  struct RCS *next;
  uint32_t id: 8;
  uint32_t CLUT_id: 8;
  uint32_t version_number: 4;
  uint32_t visible: 1; /* are we showing? */
  uint32_t clut_updated: 1; /* so it needs redrawing if already open */
  uint32_t new_objects: 1; /* so we don't have to free the object list each new PTS */
  uint32_t depth: 2;
  uint32_t width: 16;
  uint32_t height: 16;
  sprite_area_header_t *sprite_area;
  size_t sprite_size; /* just the sprite image, not headers */
  int window_handle;
  uint32_t nobjects;
  RCS_object_list_t *objects;
} RCS_t;

typedef struct CLUT
{
  struct CLUT *next;
  uint32_t id: 8;
  uint32_t version_number: 4;
  uint32_t palette4[4*2]; /* both flash states */
  uint32_t palette16[16*2];
  uint32_t palette256[256*2];
  uint32_t transtable4[4];
  uint32_t transtable16[16];
  uint32_t transtable256[256];
} CLUT_t;

typedef struct
{
  mpeg_time_t PTS;
  mpeg_time_t expiry_time;
  uint32_t PTS_known: 1; /* also used to determine if "normal case" page_state PCS's are to be ignored */
  uint32_t displayed: 1;
  uint32_t expired: 1;
  uint32_t version_number: 4;
  uint32_t nregions: 9; /* 8-bit region_ids must be unique, so <= 256 regions */
  struct
  {
    uint8_t region_id;
    uint32_t region_horizontal_address: 16;
    uint32_t region_vertical_address: 16;
  } region[256];
  RCS_t *RCSList;
  CLUT_t *CLUTList;
} PCS_t;


