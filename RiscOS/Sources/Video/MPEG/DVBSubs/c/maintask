*  as type WimpEventHandler
*
* Outputs
*  as type WimpEventHandler
*
* Returns
*  as type WimpEventHandler
*****************************************************************************/
static int WimpERedrawWindowHandler(int event_code, WimpPollBlock *event,
                                    IdBlock *id_block, void *handle)
{
  WimpRedrawWindowBlock *Redraw = (WimpRedrawWindowBlock *) &event->redraw_window_request;
  IGNORE(event_code);
  IGNORE(id_block);
  IGNORE(handle);

  for (RCS_t *RCS = static_DisplayPCS->RCSList; RCS; RCS = RCS->next)
  {
    if (RCS->window_handle == Redraw->window_handle)
    {
      int more;
      CLUT_t *CLUT;
      uint32_t *tt = NULL;

      for (CLUT = static_DisplayPCS->CLUTList; CLUT; CLUT = CLUT->next)
      {
        if (CLUT->id == RCS->CLUT_id)
        {
          switch (RCS->depth)
          {
            case 1: tt = CLUT->transtable4; break;
            case 2: tt = CLUT->transtable16; break;
            case 3: tt = CLUT->transtable256; break;
          }
          #if 0
         {
          char name[256];
          static int ttnum;
          sprintf(name, "NFS:$.Public.tt%d", ttnum++);
          _swix(OS_File, _INR(0,2)|_INR(4,5), 10, name, 0xFFD, tt, tt + (1 << (1 << RCS->depth)));
         }
          #endif
          break;
        }
      }

      CHECK(wimp_redraw_window(Redraw, &more));
      while (more)
      {
        if (RCS->sprite_area && tt)
        {
          _swi(OS_SpriteOp, _INR(0,7),
                            512+52,
                            RCS->sprite_area,
                            &RCS->sprite_area->sprite,
                            Redraw->visible_area.xmin - Redraw->xscroll,
                            -RCS->height * 2 + Redraw->visible_area.ymax - Redraw->yscroll,
                            0x20, /* overwrite, no mask, wide translation table */
                            0, /* scaling - need some */
                            tt);
        }
        else
          _swi(OS_WriteI + 16, 0); /* CLG */
        CHECK(wimp_get_rectangle(Redraw, &more));
      }
      return 1;
    }
  }

  return 0;
}

/*****************************************************************************
* ParseStream
*
* Top-level parser
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  DOES NOT RETURN
*****************************************************************************/
static void ParseStream(void)
{
  if (setjmp(static_RestartBuf) != 0)
  {
    dprintf(("", "*** Restarting ***\n"));
  }
  static_Restartable = true;

  FreeResources(static_PCS);
  FreeResources(static_PCS + 1);
  static_DecodePCSIndex = 0;
  static_DecodePCS = static_DisplayPCS = static_PCS;
  static_DecodePCS->PTS_known = false;
  static_DecodePCS->displayed = true;
  static_DecodePCS->expired = true;
  static_DataPTSValid = false;

  while (true)
  {
    uint8_t sync_byte;
    SkipToNextPESPacket();
    if (GetByte() != 0x20 || GetByte() != 0x00)
    {
      /* Not DVB subtitles (!?!) */
      continue;
    }
    while ((sync_byte = GetByte()) == 0x0F)
    {
      uint8_t segment_type;
      uint16_t page_id;
      uint16_t segment_length;
      if (static_PESLength < 5)
      {
        /* Must be corrupt data, do a reset and seek to next acquisition point */
        longjmp(static_RestartBuf, 1);
      }
      segment_type = GetByte();
      page_id = GetHalfWord();
      segment_length = GetHalfWord();
      if (segment_length >= static_PESLength) /* also allow for end_of_PES_data_field_marker */
      {
        /* Must be corrupt data, do a reset and seek to next acquisition point */
        longjmp(static_RestartBuf, 1);
      }
      if (page_id == static_CompositionPage || page_id == static_AncillaryPage)
      {
        switch (segment_type)
        {
          case 0x10:
            ParsePCS(segment_length);
            break;
          case 0x11:
            ParseRCS(segment_length);
            break;
          case 0x12:
            ParseCLUT(segment_length);
            break;
          case 0x13:
            ParseObject(segment_length);
            break;
          default:
            SkipBytes(segment_length);
            break;
        }
      }
      else
      {
        SkipBytes(segment_length);
      }
    }
    if (sync_byte != 0xFF)
    {
      /* Sync loss, do a reset and seek to next acquisition point */
      longjmp(static_RestartBuf, 1);
    }
    /* end_of_PES_field_data_marker - get next PES packet */
  }
}

/*****************************************************************************
* FreeResources
*
* Releases all memory and other system resources used for a PCS struct
*
* Assumptions
*  NONE
*
* Inputs
*  PCS: pointer to PCS struct for which to free things
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void FreeResources(PCS_t *PCS)
{
  RCS_t *RCS_ptr = PCS->RCSList;
  RCS_t *RCS_next;
  CLUT_t *CLUT_ptr = PCS->CLUTList;
  CLUT_t *CLUT_next;
  while (RCS_ptr != NULL)
  {
    RCS_next = RCS_ptr->next;
    free(RCS_ptr->sprite_area);
    free(RCS_ptr->objects);
    if (RCS_ptr->window_handle != NULL)
    {
      wimp_delete_window((WimpDeleteWindowBlock *) &RCS_ptr->window_handle);
    }
    free(RCS_ptr);
    RCS_ptr = RCS_next;
  }
  PCS->RCSList = NULL;
  while (CLUT_ptr != NULL)
  {
    CLUT_next = CLUT_ptr->next;
    free(CLUT_ptr);
    CLUT_ptr = CLUT_next;
  }
  PCS->CLUTList = NULL;
}

/*****************************************************************************
* ParsePCS
*
* Parses a Page Composition Segment
*
* Assumptions
*  NONE
*
* Inputs
*  length: number of bytes in segment
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ParsePCS(size_t length)
{
  dprintf(("Function", "ParsePCS\n"));
  if (((length - 2) % 6) != 0)
  {
    /* Malformed segment */
    longjmp(static_RestartBuf, 1);
  }
  else
  {
    uint8_t page_time_out = GetByte();
    uint8_t page_version_number = GetBits(4);
    uint8_t page_state = GetBits(2);
    ByteAlign();
    length -= 2;
    dprintf(("ParsePCS", "page_state = %d\n", page_state));
    switch (page_state)
    {
      case 2: /* mode change */
        if (static_DecodePCS->version_number != page_version_number || static_DecodePCS->PTS_known == false)
        {
          static_DecodePCSIndex ^= 1; /* toggle bank */
          static_DecodePCS = static_PCS + static_DecodePCSIndex;
          break;
        }
        else
        {
          SkipBytes(length);
          return;
        }

      case 1: /* acquisition point */
        if (static_DecodePCS->version_number != page_version_number || static_DecodePCS->PTS_known == false)
        {
          break;
        }
        else
        {
          SkipBytes(length);
          return;
        }

      case 0: /* normal case */
        if (static_DecodePCS->PTS_known && static_DecodePCS->version_number != page_version_number)
        {
          break;
        }
        /* drop through... */
      default: /* reserved */
        SkipBytes(length);
        return;
    }
    dprintf(("ParsePCS", "New page_version_number\n"));
    static_DecodePCS->PTS.word.lo = static_DataPTS.word.lo;
    static_DecodePCS->PTS.word.hi = static_DataPTS.word.hi;
    static_DecodePCS->PTS_known = true;
    {
      mpeg_interval_t mpeg_time_out = { 0 };
      mpeg_time_out.word.lo = 90000 * page_time_out;
      static_DecodePCS->expiry_time = mpegtime_AddInterval(static_DecodePCS->PTS, mpeg_time_out);
    }
    static_DecodePCS->displayed = false;
    static_DecodePCS->expired = false;
    static_DecodePCS->version_number = page_version_number;
    static_DecodePCS->nregions = length / 6;
    {
      uint32_t region;
      for (region = 0; region < static_DecodePCS->nregions; region++)
      {
        static_DecodePCS->region[region].region_id = GetByte();
        GetByte(); /* reserved byte */
        static_DecodePCS->region[region].region_horizontal_address = GetHalfWord();
        static_DecodePCS->region[region].region_vertical_address = GetHalfWord();
      }
    }
  }
}

/*****************************************************************************
* ParseRCS
*
* Parses a Region Composition Segment
*
* Assumptions
*  NONE
*
* Inputs
*  length: number of bytes in segment
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ParseRCS(size_t length)
{
  RCS_t *RCS = static_DecodePCS->RCSList;
  RCS_t *prevRCS = NULL;
  uint8_t region_id = GetByte();
  RCS_object_t *object;
  length -= 1;
  dprintf(("Function", "ParseRCS\n"));
  while (RCS != NULL && RCS->id != region_id)
  {
    prevRCS = RCS;
    RCS = RCS->next;
  }
  if (RCS == NULL)
  {
    /* A new region */
    uint8_t fill_value;
    RCS = MyAlloc(sizeof(RCS_t), 0);
    if (prevRCS == NULL)
    {
      static_DecodePCS->RCSList = RCS;
    }
    else
    {
      prevRCS->next = RCS;
    }
    RCS->id = region_id;
    RCS->version_number = GetBits(4);
    ByteAlign(); /* ignore region_fill_flag, we always fill new regions */
    RCS->width = GetHalfWord();
    RCS->height = GetHalfWord();
    GetBits(3);
    RCS->depth = GetBits(3);
    ByteAlign();
    RCS->CLUT_id = GetByte();
    {
      uint8_t colour4bit;
      uint8_t colour2bit;
      fill_value = GetByte(); /* already OK if 8bpp */
      colour4bit = GetBits(4);
      colour2bit = GetBits(2);
      ByteAlign();
      length -= 9;
      switch (RCS->depth)
      {
        case 1:
          fill_value = colour2bit | (colour2bit << 2);
          fill_value |= fill_value << 4;
          break;
        case 2:
          fill_value = colour4bit | (colour4bit << 4);
          break;
        case 3:
          break;
        default:
          free(RCS);
          SkipBytes(length);
          return;
      }
    }

    uint32_t sprite_width_in_words = ((RCS->width << RCS->depth) + 31) / 32;
    RCS->sprite_size = 4 * sprite_width_in_words * RCS->height;
    RCS->sprite_area = MyAlloc(sizeof(sprite_area_header_t) + RCS->sprite_size, fill_value);
    RCS->sprite_area->size = sizeof(sprite_area_header_t) + RCS->sprite_size;
    RCS->sprite_area->nsprites = 1;
    RCS->sprite_area->firstsprite = offsetof(sprite_area_header_t, sprite);
    RCS->sprite_area->freeword = RCS->sprite_area->size;
    RCS->sprite_area->sprite.next = sizeof RCS->sprite_area->sprite + RCS->sprite_size;
    memset(RCS->sprite_area->sprite.name, 0, sizeof RCS->sprite_area->sprite.name);
    sprintf(RCS->sprite_area->sprite.name, "region%u", region_id);
    RCS->sprite_area->sprite.wordsacross = sprite_width_in_words - 1;
    RCS->sprite_area->sprite.height = RCS->height - 1;
    RCS->sprite_area->sprite.firstbit = 0;
    RCS->sprite_area->sprite.lastbit = ((RCS->width << RCS->depth) + 31) & 31;
    RCS->sprite_area->sprite.image = sizeof RCS->sprite_area->sprite;
    RCS->sprite_area->sprite.mask = sizeof RCS->sprite_area->sprite;
    RCS->sprite_area->sprite.mode = 25 + RCS->depth;

    WimpWindow window =
    {
      .behind = -1,
      .flags = WimpWindow_NewFormat,
      .title_fg = 0xFF,
      .work_bg = 0xFF,
      .min_width = 1,
      .min_height = 1,
      .visible_area =
      {
        .xmax = RCS->width*2,
        .ymax = RCS->height*2
      },
      .extent =
      {
        .ymin = -RCS->height*2,
        .xmax = RCS->width*2
      }
    };
    CHECK(wimp_create_window(&window, &RCS->window_handle));
  }
  else
  {
    /* A region we already know about */
    bool fill_flag;
    {
      uint8_t version_number = GetBits(4);
      fill_flag = GetBits(1);
      ByteAlign();
      length -= 1;
      if (version_number == RCS->version_number)
      {
        /* We already have this version */
        SkipBytes(length);
        return;
      }
      RCS->version_number = version_number;
    }
    SkipBytes(6); /* none of these are allowed to change */
    if (fill_flag)
    {
      uint8_t fill_value = GetByte(); /* already OK if 8bpp */
      uint8_t colour4bit = GetBits(4);
      uint8_t colour2bit = GetBits(2);
      ByteAlign();
      switch (RCS->depth)
      {
        case 1:
          fill_value = colour2bit | (colour2bit << 2);
          fill_value |= fill_value << 4;
          break;
        case 2:
          fill_value = colour4bit | (colour4bit << 4);
          break;
      }
      memset(RCS->sprite_area + 1, fill_value, RCS->sprite_size);
    }
    else
    {
      SkipBytes(2);
    }
    length -= 8;
  }
  RCS->clut_updated = false;
  RCS->new_objects = (length > 0);

  /* Sort out some sort of hysteresis thingy here */
  free(RCS->objects);
  RCS->objects = MyAlloc(length/6 * sizeof RCS->objects[0], 0);
  for (object = RCS->objects; length >= 6; object++)
  {
    object->object_id = GetHalfWord();
    object->object_type = GetBits(2);
    object->object_provider_flag = GetBits(2);
    object->object_horizontal_position = GetBits(12);
    GetBits(4);
    object->object_vertical_position = GetBits(12);
    length -= 6;
    if (object->object_type == 1 || object->object_type == 2)
    {
      if (length < 2)
        break;
      object->foreground_pixel_code = GetByte();
      object->background_pixel_code = GetByte();
      length -= 2;
    }
  }
  RCS->nobjects = object - RCS->objects;

  SkipBytes(length);
}

/*****************************************************************************
* PatchUpTransparency
*
* Given a palette and a calculated translation table, change all the entries
* in the translation table that need to be transparent.
*
* Assumptions
*  NONE
*
* Inputs
*  n:       entries in palette
*  palette: source palette
*  tt:      translation table
*
* Outputs
*  tt: updated
*
* Returns
*  NOTHING
*****************************************************************************/
static void PatchUpTransparency(int n, const uint32_t *palette, void *tt)
{
  uint32_t tc = static_TransparentColour;

  switch (static_ScreenDepth)
  {
    default:
    {
      uint8_t *tt8 = tt;
      for (int i=0; i<n; i++)
        if ((palette[i] & 0xFF) == 0xFF)
          tt8[i] = tc;
      break;
    }
    case 4:
    {
      uint16_t *tt16 = tt;
      for (int i=0; i<n; i++)
        if ((palette[i] & 0xFF) == 0xFF)
          tt16[i] = tc;
      break;
    }
    case 5:
    {
      uint32_t *tt32 = tt;
      for (int i=0; i<n; i++)
        if ((palette[i] & 0xFF) == 0xFF)
          tt32[i] = tc;
      break;
    }
  }
}

/*****************************************************************************
* RecalcTransTables
*
* Recalculates the translation tables for a CLUT
*
* Assumptions
*  NONE
*
* Inputs
*  CLUT: CLUT in question
*  changed: bitfield denoting which to recalculate
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void RecalcTransTables(CLUT_t *CLUT, unsigned changed)
{
  if (changed & 2)
  {
    _swi(ColourTrans_GenerateTable, _INR(0,5),
                                    26,
                                    CLUT->palette4,
                                    -1,
                                    -1,
                                    CLUT->transtable4,
                                    0x10);
    PatchUpTransparency(4, CLUT->palette4, CLUT->transtable4);
  }
  if (changed & 4)
  {
    _swi(ColourTrans_GenerateTable, _INR(0,5),
                                    27,
                                    CLUT->palette16,
                                    -1,
                                    -1,
                                    CLUT->transtable16,
                                    0x10);
    PatchUpTransparency(16, CLUT->palette16, CLUT->transtable16);
  }
  if (changed & 8)
  {
    /* No, we can't say mode 28, as it will assume a 16-entry "brain-damaged" palette */
    _swi(ColourTrans_GenerateTable, _INR(0,5),
                                    MODE_8BPP_FULLPALETTE,
                                    CLUT->palette256,
                                    -1,
                                    -1,
                                    CLUT->transtable256,
                                    0x10);
    PatchUpTransparency(256, CLUT->palette256, CLUT->transtable256);
  }
}

static uint32_t YCrCbToRGB(int Y, int Cr, int Cb)
{
    float R, G, B;
    int32_t iR, iG, iB;

    Y -= 16;
    Cr -= 128;
    Cb -= 128;

    R = G = B = 1.16438356F * Y;
    R += 1.59602679F * Cr;
    G -= 0.812967647F * Cr;
    G -= 0.391762290F * Cb;
    B += 2.01723214F * Cb;

    iR = (int32_t) lrintf(R);
    iG = (int32_t) lrintf(G);
    iB = (int32_t) lrintf(B);

    /* This compiles better if we separate the two tests for each component -
     * the compiler tries to get clever and puts optimising branches in that
     * actually make it worse.
     */
    if (iR < 0)   iR = 0;   if (iG < 0)   iG = 0;   if (iB < 0)   iB = 0;
    if (iR > 255) iR = 255; if (iG > 255) iG = 255; if (iB > 255) iB = 255;

    return iB << 24 | iG << 16 | iR << 8;
}

/*****************************************************************************
* ParseCLUT
*
* Parses a Colour LookUp Table definition segment
*
* Assumptions
*  NONE
*
* Inputs
*  length: number of bytes in segment
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ParseCLUT(size_t length)
{
  RCS_t *RCS;
  CLUT_t *CLUT;
  uint8_t CLUT_id;
  unsigned changed = 0;

  dprintf(("Function", "ParseCLUT\n"));
  if (length < 2)
    longjmp(static_RestartBuf, 1);

  CLUT_id = GetByte();
  dprintf(("ParseCLUT", "CLUT_id=%d\n", CLUT_id));

  /* Find the CLUT if it's already defined */
  for (CLUT = static_DecodePCS->CLUTList; CLUT; CLUT = CLUT->next)
    if (CLUT->id == CLUT_id)
      break;

  /* If it's not already defined, set it to default */
  if (!CLUT)
  {
    CLUT = MyAlloc(sizeof *CLUT, 0);
    CLUT->id = CLUT_id;
    memcpy(CLUT->palette4, static_DefaultPalette4, sizeof CLUT->palette4);
    memcpy(CLUT->palette16, static_DefaultPalette16, sizeof CLUT->palette16);
    memcpy(CLUT->palette256, static_DefaultPalette256, sizeof CLUT->palette256);
    CLUT->next = static_DecodePCS->CLUTList;
    static_DecodePCS->CLUTList = CLUT;
    changed = 2 | 4 | 8; /* All TransTables need calculating */
  }

  CLUT->version_number = GetBits(4);
  ByteAlign();

  length -= 2;
  while (length)
  {
    uint8_t CLUT_entry_id;
    uint8_t Y, Cr, Cb, T;
    uint32_t pal;
    bool CLUT_flag_2, CLUT_flag_4, CLUT_flag_8, full_range_flag;
    if (length < 2)
      longjmp(static_RestartBuf, 1);
    CLUT_entry_id = GetByte();
    CLUT_flag_2 = GetBits(1);
    CLUT_flag_4 = GetBits(1);
    CLUT_flag_8 = GetBits(1);
    GetBits(4);
    full_range_flag = GetBits(1);
    length -= 2;
    if (length < (full_range_flag ? 4 : 2))
      longjmp(static_RestartBuf, 1);
    if (full_range_flag)
    {
      Y  = GetByte();
      Cr = GetByte();
      Cb = GetByte();
      T  = GetByte();
      length -= 4;
    }
    else
    {
      /* Not clear from spec what to do with lower bits. Just zeroing them seems
       * to match what some test streams seem to do.
       */
      Y  = GetBits(6) << 2;
      Cr = GetBits(4) << 4;
      Cb = GetBits(4) << 4;
      T  = GetBits(2) << 6;
      length -= 2;
    }
    /* T ranges from [0..256] - we rescale to [0..255] */
    if (Y == 0)
      pal = 0x000000FF;
    else
      pal = YCrCbToRGB(Y, Cr, Cb) | (T <= 128 ? T : T-1);

    dprintf(("ParseCLUT", "CLUT[%s%s%s%s] entry %d = (%3d,%3d,%3d,%3d) = %08X\n",
                          full_range_flag ? "F" : " ",
                          CLUT_flag_2 ? "2" : " ",
                          CLUT_flag_4 ? "4" : " ",
                          CLUT_flag_8 ? "8" : " ",
                          CLUT_entry_id,
                          Y, Cr, Cb, T, pal));

    if (CLUT_flag_2 && CLUT_entry_id < 4 && CLUT->palette4[CLUT_entry_id] != pal)
      CLUT->palette4[CLUT_entry_id] = pal, changed |= 2;

    if (CLUT_flag_4 && CLUT_entry_id < 16 && CLUT->palette16[CLUT_entry_id] != pal)
      CLUT->palette16[CLUT_entry_id] = pal, changed |= 4;

    if (CLUT_flag_8 && CLUT->palette256[CLUT_entry_id] != pal)
      CLUT->palette256[CLUT_entry_id] = pal, changed |= 8;
  }
  RecalcTransTables(CLUT, changed);

  for (RCS = static_DisplayPCS->RCSList; RCS; RCS = RCS->next)
  {
    if (RCS->CLUT_id == CLUT_id)
      RCS->clut_updated = true;
  }
}

/*****************************************************************************
* ResetMapTables
*
* Resets the Map Tables back to their default state, and fill in 256-entry
* tables if not already done.
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ResetMapTables()
{
  memcpy(static_MapTable2to4, static_DefaultMapTable2to4, sizeof static_MapTable2to4);
  memcpy(static_MapTable2to8, static_DefaultMapTable2to8, sizeof static_MapTable2to8);
  memcpy(static_MapTable4to8, static_DefaultMapTable4to8, sizeof static_MapTable4to8);

  if (!static_MapTable8to2[3])
  {
    uint32_t n;
    for (n=0; n<256; n++)
    {
      uint32_t p = (n & 0x80) ? 0xAA : 0x00;
      if (n & 0x70) p |= 0x55;
      static_MapTable8to2[n] = p;
      static_MapTable8to4[n] = (n >> 4) | (n >> 4) << 4;
      static_MapTable8to8[n] = n;
    }
  }
}

/*****************************************************************************
* ParseObject
*
* Parses an Object data segment
*
* Assumptions
*  NONE
*
* Inputs
*  length: number of bytes in segment
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ParseObject(size_t length)
{
  RCS_t *RCS;
  uint16_t object_id;
  uint8_t object_coding_method;
  bool non_modifying_colour_flag;
  uint16_t top_field_data_block_length, bottom_field_data_block_length;
  size_t processed_length;

  dprintf(("Function", "ParseObject\n"));
  object_id = GetHalfWord();
  /* object_version_number */ GetBits(4);
  object_coding_method = GetBits(2);
  non_modifying_colour_flag = GetBits(1);
  ByteAlign();
  length -= 3;

  dprintf(("ParseObject", "object_id = %d, object_coding_method = %d\n",
                          object_id, object_coding_method));

  switch (object_coding_method)
  {
    case 0: /* coding of pixels */
      if (length < 4)
        goto malformed;
      ResetMapTables();
      top_field_data_block_length = GetHalfWord();
      bottom_field_data_block_length = GetHalfWord();
      length -= 4;

      dprintf(("ParseObject", "top_field_data_block_length   =%d\n"
                              "bottom_field_data_block_length=%d\n",
                              top_field_data_block_length,
                              bottom_field_data_block_length));

      if (top_field_data_block_length > length) goto malformed;
      static_X = static_Y = 0;
      for (processed_length = 0; processed_length < top_field_data_block_length; )
      {
          processed_length += ParsePixelData(object_id,
                                             top_field_data_block_length - processed_length,
                                             bottom_field_data_block_length ? 1 : 2,
                                             non_modifying_colour_flag);
      }
      dprintf(("ParseObject", "Processed %d from top\n", processed_length));
      if (processed_length > top_field_data_block_length) goto malformed;
      length -= processed_length;

      if (bottom_field_data_block_length > length) goto malformed;
      static_X = 0, static_Y = 1;
      for (processed_length = 0; processed_length < bottom_field_data_block_length; )
      {
          processed_length += ParsePixelData(object_id,
                                             bottom_field_data_block_length - processed_length,
                                             1,
                                             non_modifying_colour_flag);
      }
      dprintf(("ParseObject", "Processed %d from bottom\n", processed_length));
      if (processed_length > bottom_field_data_block_length) goto malformed;
      length -= processed_length;

      /* If we're in any visible regions, get them redrawn. Shouldn't happen, but... */
      for (RCS = static_DisplayPCS->RCSList; RCS; RCS = RCS->next)
      {
        int n;
        if (!RCS->visible)
          continue;

        for (n = RCS->nobjects-1; n >= 0; n--)
        {
          if (RCS->objects[n].object_id == object_id)
          {
            wimp_force_redraw(RCS->window_handle, 0, -RCS->height * 2, RCS->width * 2, 0);
            break;
          }
        }
      }

      /* Fall through */

    default:
      dprintf(("ParseObject", "remaining length=%d\n", length));
      SkipBytes(length);
      return;
  }

 malformed:
  longjmp(static_RestartBuf, 1);
}

/*****************************************************************************
* ParsePixelData
*
* Parses a Pixel-data sub-block
*
* Assumptions
*  NONE
*
* Inputs
*  object_id: object_id
*  length:    number of bytes remaining in segment
*  linecount: number of rows we're filling in (1 or 2)
*  keyed:     non_modifying_colour_flag for segment
*
* Outputs
*  NONE
*
* Returns
*  number of bytes consumed
*****************************************************************************/
static size_t ParsePixelData(uint16_t object_id, size_t length, size_t linecount, bool keyed)
{
  int32_t pix;
  size_t count, consumed;
  uint8_t data_type;

  dprintf(("Function", "ParsePixelData(length = %d)\n", length));

  if (length < 1)
    longjmp(static_RestartBuf, 1);

  data_type = GetByte();
  length--;
  consumed = 0;
  switch (data_type)
    case 0x10: /* 2-bit/pixel code string */
    {
      dprintf(("ParsePixelData", "2bpp: "));
      do
      {
        pix = GetBits(2);
        consumed += 2;
        count = 1;

        if (pix == 0)
        {
          consumed += 1;
          if (GetBits(1) == 1)
          {
            /* run length 3-10 */
            count = GetBits(3) + 3;
            pix = GetBits(2);
            consumed += 5;
          }
          else
          {
            consumed += 1;
            if (GetBits(1) == 0)
            {
              consumed += 2;
              switch (GetBits(2))
              {
                case 0: /* end of string */
                  count = 0;
                  break;
                case 1: /* two 0 pixels */
                  count = 2;
                  break;
                case 2: /* run length 12-27 */
                  count = GetBits(4) + 12;
                  pix = GetBits(2);
                  consumed += 6;
                  break;
                case 3: /* run length 29-284 */
                  count = GetBits(8) + 29;
                  pix = GetBits(2);
                  consumed += 10;
                  break;
              }
            }
            else
            {
              /* one 0 pixel */
            }
          }
        }
        dprintf(("ParsePixelData", "[ %X] × %d  ", pix, count));
        ProcessPixels(object_id, 1, count, linecount, pix, keyed);
      } while (count != 0 && consumed < length * 8);
      dprintf(("ParsePixelData", "\n"));
      break;

    case 0x11: /* 4-bit/pixel code string */
      dprintf(("ParsePixelData", "4bpp: "));
      do
      {
        pix = GetBits(4);
        consumed += 4;
        count = 1;

        if (pix == 0)
        {
          consumed += 1;
          if (GetBits(1) == 0)
          {
            count = GetBits(3);
            consumed += 3;
            if (count != 0)
              count += 2; /* run length 3-9 of 0 pixels */
            /* else end of string */
          }
          else
          {
            consumed += 1;
            if (GetBits(1) == 0)
            {
              count = GetBits(2) + 4; /* run length 4-7 */
              pix = GetBits(4);
              consumed += 6;
            }
            else
            {
              consumed += 2;
              switch (GetBits(2))
              {
                case 0: /* one 0 pixel */
                  break;
                case 1: /* two 0 pixels */
                  count = 2;
                  break;
                case 2: /* run length 9-24 */
                  count = GetBits(4) + 9;
                  pix = GetBits(4);
                  consumed += 8;
                  break;
                case 3: /* run length 25-280 */
                  count = GetBits(8) + 25;
                  pix = GetBits(4);
                  consumed += 12;
                  break;
              }
            }
          }
        }
        dprintf(("ParsePixelData", "[ %X] × %d  ", pix, count));
        ProcessPixels(object_id, 2, count, linecount, pix, keyed);
      } while (count != 0 && consumed < length * 8);
      dprintf(("ParsePixelData", "\n"));
      break;

    case 0x12: /* 8-bit/pixel code string */
      dprintf(("ParsePixelData", "8bpp: "));
      do
      {
        pix = GetBits(8);
        consumed += 8;
        count = 1;

        if (pix == 0)
        {
          if (GetBits(1) == 0)
          {
            count = GetBits(7); /* run length 1-127 of 0 pixels, or end of string */
            consumed += 8;
          }
          else
          {
            count = GetBits(7);
            pix = GetBits(8);
            consumed += 16;
          }
        }
        dprintf(("ParsePixelData", "[ %X] × %d  ", pix, count));
        ProcessPixels(object_id, 3, count, linecount, pix, keyed);
      } while (count != 0 && consumed < length * 8);
      dprintf(("ParsePixelData", "\n"));
      break;

    case 0x20: /* 2 to 4-bit map-table data */
      dprintf(("ParsePixelData", "New 2 to 4-bit map-table\n"));
      for (count = 0; count < 4; count++)
      {
        pix = GetBits(4);
        static_MapTable2to4[count] = pix << 4 | pix;
      }
      consumed = 16;
      break;

    case 0x21: /* 2 to 8-bit map-table data */
      dprintf(("ParsePixelData", "New 2 to 8-bit map-table\n"));
      for (count = 0; count < 4; count++)
        static_MapTable2to8[count] = GetByte();
      consumed = 32;
      break;

    case 0x22: /* 4 to 8-bit map-table data */
      dprintf(("ParsePixelData", "New 4 to 8-bit map-table\n"));
      for (count = 0; count < 16; count++)
        static_MapTable4to8[count] = GetByte();
      consumed = 128;
      break;

    case 0xF0: /* end of object line code */
      dprintf(("ParsePixelData", "End of line\n"));
      static_X = 0;
      static_Y += 2;
      break;

    default:
      SkipBytes(length);
      consumed = 8 * length;
  }

  ByteAlign();
  consumed = (consumed + 7) / 8;

  dprintf(("ParsePixelData", "consumed=%d\n", consumed));

  if (consumed > length)
    longjmp(static_RestartBuf, 1);

  return 1 + consumed;
}

/*****************************************************************************
* ProcessPixels
*
* Draws a received row of pixels for an object into all the necessary
* regions.
*
* Assumptions
*  NONE
*
* Inputs
*  object_id: object_id
*  depth:     depth of pixel string
*  count:     number of pixels in row
*  linecount: number of rows
*  pixel:     value of pixel
*  keyed:     non_modifying_colour_flag for segment
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ProcessPixels(uint16_t object_id, int depth, size_t count, size_t linecount, uint32_t pixel, bool keyed)
{
  uint32_t X = static_X, Y = static_Y;
  const uint8_t **MapTable;
  RCS_t *RCS;
  RCS_object_t *object;
  int n;

  if (count == 0)
    return;

  if (pixel == 1 && keyed)
  {
    static_X = X + count;
    return;
  }

  MapTable = static_MapTable[depth-1];

  /* Loop over all regions */
  for (RCS = static_DecodePCS->RCSList; RCS; RCS = RCS->next)
  {
    uint32_t fill;
    depth = RCS->depth;
    fill = MapTable[depth-1][pixel];
    fill |= fill << 8;
    fill |= fill << 16;

    /* Loop over all objects in the region */
    for (n = RCS->nobjects, object = RCS->objects; n; n--, object++)
    {
      /* Check for instances of this object */
      if (object->object_id == object_id)
      {
        uint32_t x, y, x1;
        uint32_t *p, *p1, lmask, rmask;

        x = object->object_horizontal_position + X;
        y = object->object_vertical_position + Y;
        x1 = x + count;
        /* Basic clipping check. All co-ordinates unsigned, which helps. */
        if (x >= RCS->width)
          continue;
        if (x1 > RCS->width)
          x1 = RCS->width;
        x <<= depth;
        x1 <<= depth;

        /* Now do [1..linecount] lines */
        do
        {
          /* Basic clipping check. All co-ordinates unsigned, which helps. */
          if (y >= RCS->height)
            break;

          p = (uint32_t *) RCS->sprite_area + sizeof(sprite_area_header_t) / sizeof(uint32_t);
          p += y * (RCS->sprite_area->sprite.wordsacross + 1);
          p1 = p + (x1 >> 5);
          p  = p + (x >> 5);
          lmask = -(1 << (x & 31));
          rmask = (1 << (x1 & 31)) - 1;
          if (p == p1)
          {
            lmask &= rmask;
            rmask = 0;
          }
          if (lmask != 0xFFFFFFFF)
          {
            *p = (*p &~ lmask) | (fill & lmask);
            p++;
          }
          while (p < p1)
            *p++ = fill;
          if (rmask)
          {
            *p = (*p &~ rmask) | (fill & rmask);
          }

          y++;
        } while (--linecount != 0);
      }
    }
  }

  static_X = X + count;
}

/*****************************************************************************
* DisplayPage
*
* Displays a page whose PTS has been reached; if this is the first page
* of a new epoch, also frees resources claimed by the old epoch
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void DisplayPage(void)
{
  RCS_t *RCS;
  dprintf(("Function", "DisplayPage\n"));
  /* If we're switching epochs, free the old one */
  if (static_DisplayPCS != static_DecodePCS)
  {
    FreeResources(static_DisplayPCS);
    static_DisplayPCS = static_DecodePCS;
  }
  /* For each RCS that exists, determine if it's opening, closing or moving */
  for (RCS = static_DisplayPCS->RCSList; RCS != NULL; RCS = RCS->next)
  {
    int8_t region = static_DisplayPCS->nregions;
    while (--region >= 0)
    {
      if (static_DisplayPCS->region[region].region_id == RCS->id)
      {
        break;
      }
    }
    if (region < 0 && RCS->visible)
    {
      CHECK(wimp_close_window(&RCS->window_handle));
      RCS->visible = false;
    }
    else if (region >= 0)
    {
      WimpOpenWindowBlock openblock =
      {
          .window_handle = RCS->window_handle,
          .visible_area =
          {
              .xmin = static_XOrigin + static_DisplayPCS->region[region].region_horizontal_address * 2,
              .ymax = static_YOrigin - static_DisplayPCS->region[region].region_vertical_address * 2,
              .xmax = openblock.visible_area.xmin + RCS->width * 2,
              .ymin = openblock.visible_area.ymax - RCS->height * 2
          },
          .xscroll = 0,
          .yscroll = 0,
          .behind = -1
      };
      #if 0
      if (RCS->sprite_area)
      {
        char name[256];
        static int count;
        sprintf(name, "NFS:$.Public.sprite%d", ++count);
        _swix(OS_SpriteOp, _INR(0,2), 256+12, RCS->sprite_area, name);
      }
      #endif
      CHECK(wimp_open_window(&openblock));
      if (RCS->visible && RCS->clut_updated)
      {
        CHECK(wimp_force_redraw(RCS->window_handle, 0, -RCS->height * 2, RCS->width * 2, 0));
      }
      RCS->visible = true;
    }
    /* Reset a couple of flags in the RCS struct */
    RCS->clut_updated = false;
    RCS->new_objects = false;
  }
  static_DisplayPCS->displayed = true;
  inline_OS_IntOff();
  RecalcPollword();
  inline_OS_IntOn();
}

/*****************************************************************************
* SkipToNextPESPacket
*
* Keeps freeing bitstream packet descriptors until one is reached that has
* the MPEGStart flag bit set
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void SkipToNextPESPacket(void)
{
  bool NewPES;
  do
  {
    NewPES = NewPacket();
  }
  while (NewPES == false);
}

/*****************************************************************************
* SkipBytes
*
* Steps forward through the current packet by a number of bytes, getting
* new packets as they are exhausted
*
* Assumptions
*  NONE
*
* Inputs
*  bytes: number of bytes to skip
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void SkipBytes(size_t bytes)
{
  while (bytes > static_DataLength)
  {
    bytes -= static_DataLength;
    static_PESLength -= static_DataLength;
    NewPacket();
  }
  static_DataStart += bytes;
  static_DataLength -= bytes;
  static_PESLength -= bytes;
}

/*****************************************************************************
* GetHalfWord
*
* Reads a 16-bit number from the stream (fetching new packet(s) if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint16_t GetHalfWord(void)
{
  uint16_t halfword = GetByte();
  halfword <<= 8;
  halfword |= GetByte();
  return halfword;
}

/*****************************************************************************
* GetByte
*
* Reads an 8-bit number from the stream (after fetching a new packet if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint8_t GetByte(void)
{
  uint8_t byte;
  while (static_DataLength == 0)
  {
    NewPacket();
  }
  byte = *static_DataStart++;
  static_DataLength--;
  static_PESLength--;
  return byte;
}

/*****************************************************************************
* GetBits
*
* Reads a bitfield from the stream (fetching a new packet if necessary)
*
* Assumptions
*  NONE
*
* Inputs
*  bits: number of bits to fetch (up to 32)
*
* Outputs
*  NONE
*
* Returns
*  data from the stream
*****************************************************************************/
static uint32_t GetBits(uint32_t bits)
{
  uint32_t result = 0;
  while (bits > 0)
  {
    uint32_t bits_this_time = MIN(bits, static_BitsInByte);
    result <<= bits_this_time;
    while (static_DataLength == 0)
    {
      NewPacket();
    }
    result |= (*static_DataStart >> (static_BitsInByte - bits_this_time)) & ((1 << bits_this_time) -1);
    bits -= bits_this_time;
    static_BitsInByte -= bits_this_time;
    if (static_BitsInByte == 0)
    {
      static_DataStart++;
      static_DataLength--;
      static_PESLength--;
      static_BitsInByte = 8;
    }
  }
  return result;
}

/*****************************************************************************
* ByteAlign
*
* Aligns the bitfield reader to a byte boundary
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ByteAlign(void)
{
  if (static_BitsInByte < 8)
  {
    static_DataStart++;
    static_DataLength--;
    static_PESLength--;
    static_BitsInByte = 8;
  }
}

/*****************************************************************************
* NewPacket
*
* The hub of the whole system: this appears from the point of view of the
* caller to return with the next bitstream packet to process. In practice,
* it will actually Wimp_Poll if the packet list is exhausted, so all Wimp
* events are dispatched from here. Control is returned when new data arrives
* using a Wimp pollword, but the pollword is shared between indicating that
* new data is available, and that a timestamp match has occurred. The packet
* list is treated as empty if it contains data that is timestamped later than
* the currently decoding display set (ie the display set that has started
* decoding, but which has not been displayed yet).
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  static_DataPTS, static_DataPTSValid, static_DataStart, static_DataLength,
*  and, if a new PES packet, static_PESLength are updated
*
* Returns
*  true if the bitstream packet descriptor is at the head of a PES packet
*****************************************************************************/
static bool NewPacket(void)
{
  static PacketDescriptor_t *WorkingPacket = (PacketDescriptor_t *) -1;
    /* ie initialise with magic value guaranteed not be be on the packet list */
  packet_FreeHead_USR(&static_PacketListHead, &static_PacketListTail, WorkingPacket);

  while (true)
  {
    /* Check for data that should be decoded at this time */
    do
    {
      /* Make an atomic copy of the head link, to cope with asynchronous update */
      WorkingPacket = static_PacketListHead;

      if (WorkingPacket == NULL)
      {
        /* We usually get here because we've just freed the last packet on the list. */
        /* If so, we need to clear the pollword so that Wimp_Poll doesn't immediately return. */
        /* If the pollword would have been set due to a pending PTS match, this isn't a */
        /* problem, because we're just about to test that ourselves. */
        /* There is a slim chance that data may have arrived in the interval between the */
        /* assignment and test of WorkingPacket, but even then, the pollword will be set at */
        /* the next VSync, at the latest. */
        static_PollWord = false;
      }
      else
      {
        /* Check packet at head of list for special actions */
        if (WorkingPacket == &static_MagicDescriptor_Reset)
        {
          longjmp(static_RestartBuf, 1);
        }
        else if (WorkingPacket == &static_MagicDescriptor_Exit)
        {
          exit(EXIT_SUCCESS);
        }

        /* Unless the data on the list is for the next PTS and we haven't */
        /* displayed this one yet, return the next packet (if any) */
        if (static_DecodePCS->displayed ||
            (WorkingPacket->Flags & PacketDescriptorFlags_PTSValid) == 0 ||
            (WorkingPacket->PTS.word.lo == static_DecodePCS->PTS.word.lo && WorkingPacket->PTS.word.hi == static_DecodePCS->PTS.word.hi) ||
            !static_DecodePCS->PTS_known)
        {
          bool NewPES = (WorkingPacket->Flags & PacketDescriptorFlags_MPEGStart) != 0;
          static_DataStart = WorkingPacket->Start;
          static_DataLength = WorkingPacket->Length;
          if (NewPES)
          {
            static_PESLength = WorkingPacket->FullLength;
          }
          if ((WorkingPacket->Flags & PacketDescriptorFlags_PTSValid) != 0)
          {
            if (static_DataPTSValid && mpegtime_Before(WorkingPacket->PTS, static_DataPTS))
            {
              /* Oops, time has jumped backwards */
              /* We'd better reset ourselves */
              longjmp(static_RestartBuf, 1);
            }
            static_DataPTS.word.lo = WorkingPacket->PTS.word.lo;
            static_DataPTS.word.hi = WorkingPacket->PTS.word.hi;
            static_DataPTSValid = true;
          }
          if (WorkingPacket != static_PacketListHead)
          {
            /* Blast, it's been freed while I wasn't looking */
            /* The pointers I read from the descriptor may be bad, */
            /* so we'll just have to ditch it altogether */
            continue; /* this is effectively a goto to the do statement ;-) */
          }
          /* Return to our caller, which will read static_DataStart/Length */
          return(NewPES);
        }
      }
    }
    while (false);

    /* Check if it's time to display the page */
    if (static_DecodePCS->PTS_known && !static_DecodePCS->displayed)
    {
      mpeg_time_t STC = { 0 };
      _swix(MPEGControl_ReadParameters, _INR(0,1)|_OUTR(1,2),
            3,
            static_ControlStreamHandle,
            &STC.word.lo,
            (&STC.word.lo) + 1);
      if ((STC.word.lo != 0 || STC.word.hi != 0) &&
          !mpegtime_Before(STC, static_DecodePCS->PTS))
      {
        DisplayPage();
      }
    }

    /* Poll until something interesting happens */
    {
      int event_code;
      do
      {
        CHECK(event_poll(&event_code, NULL, &static_PollWord));
      }
      while (event_code != Wimp_EPollWordNonZero);
    }
  } /* end while (true) */
}

/*****************************************************************************
* RecalcPollword
*
* Sets the pollword appropriately when some aspect of the state has changed
* (necessary in order to share a single pollword for waking up the task)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void RecalcPollword(void)
{
  /* Check for pertinent stuff on the packet list */
  PacketDescriptor_t *HeadPacket = static_PacketListHead; /* lose volatile attribute */
  static_PollWord = false; /* default state */
  if (HeadPacket != NULL)
  {
    /* Magic packets always need acting on */
    if (HeadPacket == &static_MagicDescriptor_Reset || HeadPacket == &static_MagicDescriptor_Exit)
    {
      static_PollWord = true;
    }
    else
    {
      /* If we haven't got our first PTS yet, or */
      /* if the head packet on the list matches the current PTS, or */
      /* if the head packet on the list has no PTS, or */
      /* if the head packet on the list is for a later PTS and we've displayed the current page */
      /* then we need to decode some data */
      if (static_DecodePCS->displayed ||
          (HeadPacket->Flags & PacketDescriptorFlags_PTSValid) == 0 ||
          (HeadPacket->PTS.word.lo == static_DecodePCS->PTS.word.lo && HeadPacket->PTS.word.hi == static_DecodePCS->PTS.word.hi) ||
          !static_DecodePCS->PTS_known)
      {
        static_PollWord = true;
      }
    }
  }
  /* Check for a time match (unless we've already established that the pollword is set!) */
  if (static_PollWord == false && static_DecodePCS->PTS_known && !static_DecodePCS->displayed)
  {
    mpeg_time_t STC = { 0 };
    _swix(MPEGControl_ReadParameters, _INR(0,1)|_OUTR(1,2),
          3,
          static_ControlStreamHandle,
          &STC.word.lo,
          (&STC.word.lo) + 1);
    if ((STC.word.lo != 0 || STC.word.hi != 0) &&
        !mpegtime_Before(STC, static_DecodePCS->PTS))
    {
      static_PollWord = true;
    }
  }
}

/*****************************************************************************
* MyAlloc
*
* Allocates a block of memory from the heap, throwing an error if it can't
*
* Assumptions
*  NONE
*
* Inputs
*  size:       number of bytes to allocate in block
*  init_value: byte value to initialise block with
*
* Outputs
*  NONE
*
* Returns
*  pointer to block
*****************************************************************************/
static void *MyAlloc(size_t size, uint8_t init_value)
{
  void *memory = malloc(size);
  if (memory == NULL)
  {
    inline_OS_GenerateError(mess_GenerateError("err_Mem", 1, 0));
  }
  memset(memory, init_value, size);
  return memory;
}

/*****************************************************************************
* maintask_RemoveHandlers
*
* Remove any installed direct-call handlers (prior to module death)
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
void maintask_RemoveHandlers(void)
{
  /* At least one of these will produce an error, but that's okay */
  _swix(OS_Release, _INR(0,2),
        UpCallV,
        upcallv_handler,
        global_PrivateWord);
  _swix(MPEGControl_DeregisterDescriptorHandler, _INR(0,4),
        DHFlags_StreamSpecific,
        DVB_SUBTITLING_DESCRIPTOR_TAG,
        descriptor_handler,
        global_PrivateWord,
        static_ControlStreamHandle);
  if (static_SubtitlePID != 0)
  {
    _swix(MPEGControl_DeregisterProgramElementHandler, _INR(0,4),
          PEHFlags_StreamIdentifiedByPID | PEHFlags_StreamSpecific,
          static_SubtitlePID,
          program_element_handler,
          global_PrivateWord,
          static_ControlStreamHandle);
    static_SubtitlePID = 0;
  }
  if (static_EventVClaimed)
  {
    _swix(OS_Byte, _INR(0,1),
          13,
          Event_VSync);
    _swix(OS_Release, _INR(0,2),
          EventV,
          eventv_handler,
          global_PrivateWord);
    static_EventVClaimed = false;
  }
}

/*****************************************************************************
* FindScreenOrigin
*
* Compensates for VIDC border
*
* Assumptions
*  NONE
*
* Inputs
*  NONE
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void FindScreenOrigin(void)
{
  uint32_t out_block[5];
  uint32_t width;
  uint32_t height;
  _swix(OS_ReadVduVariables, _INR(0,1),
        (const uint32_t[6]) { 4, 5, 11, 12, 9, -1 },
        out_block);
  width = out_block[2] << out_block[0];
  height = out_block[3] << out_block[1];
  static_XOrigin = (width / 2) - 720;
  static_YOrigin = (height / 2) + 576; /* doesn't matter that it's exclusive, because so are window tops */

  switch (static_ScreenDepth = out_block[4])
  {
    default: static_TransparentColour = 1; break;
    case 4: static_TransparentColour = 0x8000; break;
    case 5: static_TransparentColour = 0xFF000000; break;
  }
}

