/*****************************************************************************
* BackgroundFlush
*
* Flushes the packet queue from the background, and leaves a marker packet
* to tell the foreground what's happened
*
* Assumptions
*  Entered in SVC mode
*
* Inputs
*  magic_packet: the packet to leave on the list
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void BackgroundFlush(PacketDescriptor_t *magic_packet)
{
  /* Free all the packets */
  while (static_PacketListHead != NULL)
  {
    packet_FreeHead_SVC(&static_PacketListHead, NULL);
  }

  /* Stick a single (magic) packet on the list */
  static_PacketListHead = static_PacketListTail = magic_packet;

  /* Set the pollword */
  static_PollWord = true;
}


