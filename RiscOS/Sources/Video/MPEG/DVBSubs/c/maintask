/*****************************************************************************
* maintask_Main
*
* Entry point for task
*
* Assumptions
*  NONE
*
* Inputs
*  command line arguments
*
* Outputs
*  NONE
*
* Returns
*  pointer to error block, if initialisation failed
*****************************************************************************/
_kernel_oserror *maintask_Main(char *argv[5])
{
  /* Install our desired environment */
  static_Restartable = false;
  {
    uint32_t CLibVersion;
    sscanf(_clib_version(), "%*[^0123456789]%" SCNu32, &CLibVersion);
    if (CLibVersion < 535)
    {
      /* Older CLibs don't have nice default handlers for these signals */
      signal(SIGABRT, FatalErrorHandler);
      signal(SIGFPE, FatalErrorHandler);
      signal(SIGILL, FatalErrorHandler);
      signal(SIGSEGV, FatalErrorHandler);
      signal(SIGTERM, FatalErrorHandler);
      signal(SIGSTAK, FatalErrorHandler);
    }
  }
  signal(SIGINT, EscapeHandler);
  signal(SIGOSERROR, ErrorHandler);

  /* Parse command line */
  sscanf(argv[1], "%8X", &static_VideoCtrlClientHandle);
  sscanf(argv[2], "%c%c%c", static_ISO639Lang, static_ISO639Lang + 1, static_ISO639Lang + 2);
  sscanf(argv[3], "%u", &static_HardOfHearing);

  /* Start up Wimp task */
  static int MessagesList[] = { Wimp_MTTextAndSubsOff, 0 };
  const char *TaskName;
  CHECK(mess_LookUp("MainTask", &TaskName, 0));
  CHECK(wimp_initialise(WIMP_VERSION, (char *) TaskName, MessagesList, NULL, &global_TaskHandle));

  /* Successful acknowledge message must be sent from this task */
  {
    WimpMessage Message;
    WimpTTextAndSubsOnAckMessage *OnAckMessage;
    int OtherTask;
    OnAckMessage = (WimpTTextAndSubsOnAckMessage *) Message.data.words;
    sscanf(argv[4], "%8X", &OtherTask);
    Message.hdr.size = (char *) &(OnAckMessage->errnum) - (char *) &Message;
    sscanf(argv[5], "%8X", &Message.hdr.your_ref);
    Message.hdr.action_code = Wimp_MTTextAndSubsOnAck;
    OnAckMessage->flags = 0;
    OnAckMessage->videoctrl_client_handle = static_VideoCtrlClientHandle;
    CHECK(wimp_send_message(Wimp_EUserMessage, &Message, OtherTask, 0, NULL));
  }

  /* Before we register any direct-call handlers into the module code, */
  /* register an atexit function to remove them all */
  atexit(maintask_RemoveHandlers);

  /* Try to register our subtitle descriptor handler */
  /* To do this, we need the control stream handle; if we can't determine it (ie stream is not */
  /* yet open) then we need to sit on UpCallV, so that we can do it when the stream does open */
  {
    _kernel_oserror *e;
    uint32_t OptionsBlock[] = { vc_tags_control_handle, 1, 0, vc_tags__end };
    inline_OS_IntOff();
    e = _swix(VideoControl_Options, _INR(0,2),
              VC_Options_ReadValues,
              static_VideoCtrlClientHandle,
              OptionsBlock);
    if (e != NULL || OptionsBlock[2] == 0)
    {
      _swi(OS_Claim, _INR(0,2),
           UpCallV,
           upcallv_handler,
           global_PrivateWord);
      inline_OS_IntOn();
    }
    else
    {
      inline_OS_IntOn();
      static_ControlStreamHandle = OptionsBlock[2];
      _swi(MPEGControl_RegisterDescriptorHandler, _INR(0,4),
           DHFlags_StreamSpecific,
           DVB_SUBTITLING_DESCRIPTOR_TAG,
           descriptor_handler,
           global_PrivateWord,
           static_ControlStreamHandle);
    }
  }

  /* Claim VSync events */
  _swi(OS_Claim, _INR(0,2),
       EventV,
       eventv_handler,
       global_PrivateWord);
  {
    _kernel_oserror *e;
    e = _swix(OS_Byte, _INR(0,1),
              14,
              Event_VSync);
    if (e)
    {
      _swix(OS_Release, _INR(0,2),
            EventV,
            eventv_handler,
            global_PrivateWord);
      inline_OS_GenerateError(e);
    }
  }
  static_EventVClaimed = true;

  /* Initialise EventLib */
  CHECK(event_initialise(NULL));
  atexit((void(*)(void))event_finalise);
  CHECK(event_set_mask(Wimp_Poll_NullMask |
                       Wimp_Poll_PointerLeavingWindowMask |
                       Wimp_Poll_PointerEnteringWindowMask |
                       Wimp_Poll_LoseCaretMask |
                       Wimp_Poll_GainCaretMask |
                       Wimp_Poll_PollWord));
  CHECK(event_register_message_handler(Wimp_MQuit, WimpMQuitHandler, 0));
  CHECK(event_register_message_handler(Wimp_MTTextAndSubsOff, WimpMTTextAndSubsOffHandler, 0));
  CHECK(event_register_wimp_handler(-1, Wimp_ERedrawWindow, WimpERedrawWindowHandler, 0));

  /* Locate the origin for subtitle coordinates */
  FindScreenOrigin();

  /* Parse the stream */
  ParseStream();

  return NULL;
}

/*****************************************************************************
* EscapeHandler
*
* Handles SIGINT
*
* Assumptions
*  NONE
*
* Inputs
*  sig: signal number
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void EscapeHandler(int sig)
{
  signal(sig, EscapeHandler);
}

/*****************************************************************************
* ErrorHandler
*
* Handles SIGOSERROR
*
* Assumptions
*  NONE
*
* Inputs
*  sig: signal number
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void ErrorHandler(int sig)
{
  if (DisplayErrorBox(!static_Restartable, false))
  {
    exit(EXIT_FAILURE);
  }
  else
  {
    signal(sig, ErrorHandler);
    longjmp(static_RestartBuf, 1);
  }
}

/*****************************************************************************
* FatalErrorHandler
*
* Handles all signals other than SIGINT and SIGOSERROR
*
* Assumptions
*  NONE
*
* Inputs
*  sig: signal number
*
* Outputs
*  NONE
*
* Returns
*  NOTHING
*****************************************************************************/
static void FatalErrorHandler(int sig)
{
  IGNORE(sig);
  DisplayErrorBox(true, true);
  exit(EXIT_FAILURE);
}

/*****************************************************************************
* DisplayErrorBox
*
* Common Wimp error box stuff for ErrorHandler() and FatalErrorHandler()
*
* Assumptions
*  NONE
*
* Inputs
*  fatal:   true if the user is to be denied a "Continue" button
*  serious: true if the error is to be flagged as a program report rather than error report
*
* Outputs
*  NONE
*
* Returns
*  true if the user clicked on "Quit"
*****************************************************************************/
static bool DisplayErrorBox(bool fatal, bool serious)
{
  _kernel_oserror *e = _kernel_last_oserror();
  char ExtraButtons[32] = "Quit";
  char TaskName[32] = "Error";
  MessagesFD WimpMessages;
  bool OurMessagesBroken = false;

  if (e == NULL)
  {
    e = mess_GenerateError("err_UKError", 0, 0);
  }

  /* First try to internationalise "Quit" and "Error" using the Wimp messages file */
  if (_swix(MessageTrans_OpenFile, _INR(0,2),
            &WimpMessages,
            "WindowManager:Messages",
            0) == NULL)
  {
    _swix(MessageTrans_Lookup, _INR(0,7),
          &WimpMessages,
          "Quit",
          ExtraButtons,
          sizeof(ExtraButtons),
          0, 0, 0, 0);
    _swix(MessageTrans_Lookup, _INR(0,7),
          &WimpMessages,
          "Error",
          TaskName,
          sizeof(TaskName),
          0, 0, 0, 0);
    _swix(MessageTrans_CloseFile, _IN(0),
          &WimpMessages);
  }

  /* If our own messages file works, get our task name */
  if (_swix(MessageTrans_Lookup, _INR(0,7),
            &global_MessageFD,
            "MainTask",
            TaskName,
            sizeof(TaskName),
            0, 0, 0, 0) != NULL)
  {
    OurMessagesBroken = true;
  }

  /* Display an appropriate error box */
  return (1 != wimp_report_error(e,
      (fatal ? 0 : Wimp_ReportError_OK) | (OurMessagesBroken ? Wimp_ReportError_NoAppName : 0) | 1u<<8 | (serious ? 3u<<9 : 2u<<9),
      TaskName, "switcher", 1, ExtraButtons));
}

/*****************************************************************************
* WimpMQuitHandler
*
* Handles Wimp_MQuit
*
* Assumptions
*  NONE
*
* Inputs
*  as type WimpMessageHandler
*
* Outputs
*  as type WimpMessageHandler
*
* Returns
*  as type WimpMessageHandler
*****************************************************************************/
static int WimpMQuitHandler(WimpMessage *message, void *handle)
{
  IGNORE(message);
  IGNORE(handle);
  exit(EXIT_SUCCESS);
  /* In this case, the preveneer's exit handler will kill the instantiation too */
  return 1;
}

/*****************************************************************************
* WimpMTTextAndSubsOffHandler
*
* Handles Wimp_MTextAndSubsOff
*
* Assumptions
*  NONE
*
* Inputs
*  as type WimpMessageHandler
*
* Outputs
*  as type WimpMessageHandler
*
* Returns
*  as type WimpMessageHandler
*****************************************************************************/
static int WimpMTTextAndSubsOffHandler(WimpMessage *message, void *handle)
{
  WimpTTextAndSubsOffAckMessage *OffAckMessage = (WimpTTextAndSubsOffAckMessage *) message->data.words;
  IGNORE(handle);
  /* Acknowledge message, then exit */
  message->hdr.size = sizeof(message->hdr) + sizeof(*OffAckMessage);
  message->hdr.your_ref = message->hdr.my_ref;
  message->hdr.action_code = Wimp_MTTextAndSubsOffAck;
  OffAckMessage->flags = 0;
  wimp_send_message(Wimp_EUserMessage, message, message->hdr.sender, 0, NULL); /* ignore errors */
  exit(EXIT_SUCCESS);
  return 1;
}

