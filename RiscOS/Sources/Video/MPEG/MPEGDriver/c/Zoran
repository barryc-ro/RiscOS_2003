void Zoran_CheckTime(unsigned int *ptc, unsigned int *stc);
void Zoran_CheckTime(unsigned int *ptc, unsigned int *stc)
{
  zoran_interface_t *zoran = Interfaces;
  char response[8];
  zoran->command(ZCMD_GETPTC, 0, response);
  *ptc = (response[0] << 24) | (response[1] << 16) | (response[2] << 8) | response[3];
  *stc = (response[4] << 24) | (response[5] << 16) | (response[6] << 8) | response[7];
}

_kernel_oserror *Zoran_BodgePlay(uint32_t flags, uint32_t event_handle);
_kernel_oserror *Zoran_BodgePlay(uint32_t flags, uint32_t event_handle)
{
  IGNORE(flags);
  zoran_interface_t *zoran = (zoran_interface_t *) event_handle;
  _kernel_oserror *e = Zoran_Start(0, zoran);
  typedef struct
  {
    unsigned int magic;
    
