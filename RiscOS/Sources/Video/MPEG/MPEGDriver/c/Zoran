/******	Zoran_Start() ******************************************************

Purpose:	Enable decoding/display
In:		flags:          bit 0 set => decode data in reverse, bit 0 clear => decode data forwards
		session_id:	session ID (pointer to interface struct)
Out:		Error pointer

***************************************************************************/

_kernel_oserror *Zoran_Start (unsigned int flags, void *session_id)
{
  zoran_interface_t *zoran = session_id;
  _kernel_oserror *e = NULL;
  if (!zoran->flag_characterising) /* else we have to wait! */
  {
    mpeg_time_t stc;
    zoran->clock->StreamInfo(12, zoran->clockhandle, &stc);
    static struct
    {
      unsigned : 5;           unsigned SCU: 1;        unsigned AVS: 1;        unsigned : 1;
      unsigned STC_31_24: 8;
      unsigned STC_23_16: 8;
      unsigned STC_15_8: 8;
      unsigned STC_7_0: 8;
      unsigned VDY_15_8: 8;
      unsigned VDY_7_0: 8;
    }
    SETSTC_Params =
    {
      1, 0,
      0,
      0,
      0,
      0,
      0,
      0
    };
    SETSTC_Params.STC_31_24 = stc.word.lo >> 24;
    SETSTC_Params.STC_23_16 = stc.word.lo >> 16;
    SETSTC_Params.STC_15_8 = stc.word.lo >> 8;
    SETSTC_Params.STC_7_0 = stc.word.lo;
    zoran->command (ZCMD_SETSTC, (const char *) &SETSTC_Params, 0);
    zoran->command (ZCMD_PLAY, 0, 0);
    zoran->command (ZCMD_UNMUTE, 0, 0);
    _swix (OS_CallEvery, _INR(0,2), 1, CallEvery_Veneer, zoran); /* eventually use this for polling underrun state */
  }
  zoran->flag_started = true;
  return e;
}

