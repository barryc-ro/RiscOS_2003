_kernel_oserror *Zoran_GetBufferLength (uint32_t flags, stream_handle_t decoder_handle, uint32_t *length, zoran_interface_t *zoran)
{
#if Debugging == 1 && DebugZoranEntries == 1
  DWrite_Write0("Zoran_GetBufferLength ");
#endif
  IGNORE(flags);
  IGNORE(decoder_handle);
  /* Read the current bitrate */
  uint32_t bitrate; /* bits/second */
  _kernel_oserror *e = Zoran_StreamInfo(zoran, ptlaudio_STREAM_INFO_BITRATE, &bitrate);
  if (e != NULL)
  {
    bitrate = 0;
  }
  if (bitrate == 0)
  {
    *length = 0;
  }
  else
  {
    uint32_t bytes_buffered;
    zoran->howmuchdata(0, zoran->toplevelhandle, 0, &bytes_buffered);
    *length = ((90 * 8) * bytes_buffered) / (bitrate / 1000); /* avoid overflows! */
  }
  return NULL;
}

_kernel_oserror *Zoran_AdjustRate (uint32_t flags, stream_handle_t decoder_handle, zoran_interface_t *zoran)
{
  _kernel_oserror *e = NULL;
#if Debugging == 1 && DebugZoranEntries == 1
  DWrite_Write0("Zoran_AdjustRate ");
#endif
  IGNORE(decoder_handle);
  if (zoran->flag_started)
  {
    static struct
    {
      unsigned EXT: 8;
      unsigned : 8;
      unsigned LO_MSB: 8;
      unsigned LO_LSB: 8;
      unsigned : 8;
      unsigned HI_MSB: 8;
      unsigned HI_LSB: 8;
    }
    VCXO_Params =
    {
      8
    };
    switch (flags & 3)
    {
      case 1: /* slow */
        VCXO_Params.LO_MSB = 500 >> 8;
        VCXO_Params.LO_LSB = 500 & 0xFF;
        VCXO_Params.HI_MSB = 65535 >> 8;
        VCXO_Params.HI_LSB = 65535 & 0xFF;
  //      printf("S");
        break;
      case 2: /* fast */
        VCXO_Params.LO_MSB = 65535 >> 8;
        VCXO_Params.LO_LSB = 65535 & 0xFF;
        VCXO_Params.HI_MSB = 500 >> 8;
        VCXO_Params.HI_LSB = 500 & 0xFF;
  //      printf("F");
        break;
      default: /* normal */
        VCXO_Params.LO_MSB = 5000 >> 8;
        VCXO_Params.LO_LSB = 5000 & 0xFF;
        VCXO_Params.HI_MSB = 5000 >> 8;
        VCXO_Params.HI_LSB = 5000 & 0xFF;
        break;
    }
    zoran->command(ZCMD_PARAM_2, (char *)&VCXO_Params, 0);
  }
  else
  {
    static struct { int errnum; char errmess[32]; } error = { 1, "Cannot adjust rate at this time" };
    /* This error isn't going to be reported to the user, so no need to internationalise */
    e = (_kernel_oserror *) &error;
  }
  return e;
}

/******	Zoran_EstablishMPA() ***********************************************

Purpose:	Stream initialisation (MPEG audio case)
In:		Flags; pointer to interface struct for this stream
Out:		Error pointer

***************************************************************************/

_kernel_oserror *Zoran_EstablishMPA (unsigned int flags, stream_handle_t clock_handle, zoran_interface_t *zoran)
{
#if Debugging == 1 && DebugZoranEntries == 1
  DWrite_Write0("Zoran_EstablishMPA ");
#endif
  _kernel_oserror *e = NULL;
  static const zoran_characteriser_protocol_fns_t mpacharacterisermodule =
    { RecogMPA_Establish, RecogMPA_Annul, RecogMPA_Commence, RecogMPA_Discontinue, RecogMPA_DataAvailable, RecogMPA_ConsumeData, RecogMPA_StreamInfo };
  zoran->characteriser = &mpacharacterisermodule;
  e = zoran->characteriser->establish (flags, MPA_Characteriser, zoran, &zoran->characteriserhandle);
  if (!e)
  {
    /* Add to global list */
    zoran->link = Interfaces;
    Interfaces = zoran;
    /* Flag as MPEG audio */
    zoran->flag_ac3notmpa = false;
    zoran->flag_started = false;
    /* Register with PFCClock */
    zoran->clockhandle = clock_handle;
    static bool my_table_initialised = false;
    static prism_function_table_clock_to_decoder_t my_table;
    if (!my_table_initialised++)
    {
      my_table = (prism_function_table_clock_to_decoder_t)
      {
        zoran->veneers->ClockCorrection,
        zoran->veneers->SpeedChange,
        zoran->veneers->ActivateSyncControl,
        zoran->veneers->GetBufferLength,
        zoran->veneers->AdjustRate
      };
    }
    e = _swix(PFCClock_DecoderRegister, _INR(0,5)|_OUT(3), 1, zoran->prism_id, zoran, clock_handle, &my_table, 0/*10*/, &zoran->clock);
  }
  return e;
}

