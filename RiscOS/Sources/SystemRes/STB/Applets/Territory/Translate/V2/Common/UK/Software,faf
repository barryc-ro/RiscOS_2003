    <SCRIPT language="JavaScript1.1" type="text/javascript">

    function output_information()
    {
      var input = new String(navigator.appVersion);
      var strip = "compatible; ";
      var search = input.indexOf(strip);
      var output = input.substring(search + strip.length,input.length-1);
      var temp, remaining, i, separator, stringarray;

      separator = "; ";
      stringarray = output.split(separator);

      document.write("<TABLE WIDTH=100% BORDER=0 CELLSPACING=0 CELLPADDING=0");

      document.write("<TR><TD>SoftW_elementname‘‘</TD><TD WIDTH=160 CLASS='opt_text'>SoftW_versionhead‘‘</TD></TR>");
      document.write("<TR><TD COLSPAN=2 HEIGHT=5></TD></TR>");
      document.write("</TABLE>");

      document.write("<TABLE WIDTH=100% BORDER=0 CELLSPACING=0 CELLPADDING=0");

      for (i =0; i<stringarray.length; i++)
      {
        if (stringarray[i].substring(0, 4) != "RISC")
        {
          document.write("<TR><TD WIDTH=20></TD>");

          temp = stringarray[i].split("/");
          document.write("<TD CLASS='opt_text' STYLE='color:#0000aa'>",temp[0],"</TD>");
          document.write("<TD WIDTH=130 CLASS='opt_text' STYLE='color:#0000aa'>",temp[1],"</TD>");

          document.write("</TR>");
        }

        if (stringarray[i].substring(0, 4) == "RISC")
        {
          document.write("<TR><TD WIDTH=20></TD>");

          temp = stringarray[i].split(" ");
          document.write("<TD CLASS='opt_text' STYLE='color:#0000aa'>",temp[0]," ",temp[1],"</TD>");
          document.write("<TD WIDTH=130 CLASS='opt_text' STYLE='color:#0000aa'>",temp[2],"</TD>");

          document.write("</TR>");
        }
      }

      document.write("</TABLE>");

    }
    </SCRIPT>

